{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "frontendPort",
      "type": "promptString",
      "description": "Frontend port",
      "default": "3000"
    }
  ],
  "configurations": [
    {
      "name": "Start App (Tasks) + Open Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:${input:frontendPort}",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Start App (Backend + Frontend)"
    },
    {
      "name": "Start Frontend (Task) + Open Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:${input:frontendPort}",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Run Frontend"
    },
    {
      "name": "Run Backend (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "backend.main:app", "--reload"],
      "console": "integratedTerminal",
      "env": {
        "DATABASE_URL": "sqlite:///./flashcards.db"
      },
      "justMyCode": true
    },
    {
      "name": "Attach to debugpy",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    }
  ]
}
